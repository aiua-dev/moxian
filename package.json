{
  "name": "moxian",
  "version": "0.1.0",
  "description": "墨线：面向中文长篇创作的连续性内核与 CLI。管伏笔、人物、时间线、设定与大纲，按章给 agent 递料",
  "keywords": [
    "小说",
    "网文",
    "写作",
    "创作",
    "连续性",
    "伏笔",
    "novel",
    "fiction",
    "writing",
    "continuity",
    "cli",
    "agent"
  ],
  "author": "An-6021",
  "license": "AGPL-3.0-or-later",
  "type": "module",
  "bin": {
    "moxian": "./dist/cli.js"
  },
  "exports": {
    ".": "./dist/index.js"
  },
  "files": [
    "dist",
    "skills",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/aiua-dev/moxian.git"
  },
  "homepage": "https://github.com/aiua-dev/moxian#readme",
  "bugs": {
    "url": "https://github.com/aiua-dev/moxian/issues"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsx src/cli.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "tsc -p tsconfig.json && vitest run",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "commander": "^15.0.0",
    "yaml": "^2.9.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^26.6.1",
    "tsx": "^4.23.13",
    "typescript": "^7.0.2",
    "vitest": "^5.0.1"
  }
}
